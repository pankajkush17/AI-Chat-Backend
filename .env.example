# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/chat_agent

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported values: openai | azure-openai
LLM_PROVIDER=azure-openai

# ── Option A: Standard OpenAI ─────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Option B: Azure OpenAI ────────────────────────────────────────────────────
# Required when LLM_PROVIDER=azure-openai
AZURE_OPENAI_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure deployment names (the name you gave each model in Azure AI Studio)
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT5_DEPLOYMENT=gpt-5

# ── Shared LLM settings ───────────────────────────────────────────────────────
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000

# Input limits
MAX_MESSAGE_LENGTH=4000

# CORS — set to your frontend origin
CORS_ORIGIN=http://localhost:5173

# Redis (optional — omit to skip caching and fall back to PostgreSQL)
REDIS_URL=redis://localhost:6379
