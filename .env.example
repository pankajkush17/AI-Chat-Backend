# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://<user>@localhost:5432/<database>

# LLM Provider (openai | azure-openai)
LLM_PROVIDER=openai

# Option A: Standard OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Option B: Azure OpenAI (required when LLM_PROVIDER=azure-openai)
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure deployment names (exact name from Azure AI Studio)
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o

# Shared LLM settings
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000

# Input limits
MAX_MESSAGE_LENGTH=4000

# CORS
CORS_ORIGIN=http://localhost:5173

# Redis (optional — omit to run without caching)
REDIS_URL=redis://localhost:6379
